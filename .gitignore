# ==========================================
# 🛡️ ContractGuard — Git Ignore Configuration
# Production-ready ignore patterns for Python, React/Vite, PyTorch, & OS
# ==========================================

# ------------------------------------------
# Python & Virtual Environments
# ------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# ------------------------------------------
# Node.js & Frontend (Vite + React)
# ------------------------------------------
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
frontend/*.local
node_modules/
.npm/
.yarn/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ------------------------------------------
# Machine Learning Checkpoints & Weights
# ------------------------------------------
model/checkpoints/*
!model/checkpoints/.gitkeep
*.pt
*.pth
*.bin
*.onnx
*.safetensors
.huggingface/

# ------------------------------------------
# Dataset Raw Files & Temp Uploads
# ------------------------------------------
data/raw_contracts/
data/legal_corpus/
data/faiss_index/*.index
*.pdf
*.docx
!legal/*.pdf

# ------------------------------------------
# Environment Variables & Secrets
# ------------------------------------------
.env
.env.local
.env.*.local
*.pem
*.key

# ------------------------------------------
# IDE & System Files
# ------------------------------------------
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
.idea/
*.swp
*.swo
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
