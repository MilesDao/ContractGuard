# ==========================================
# 🛡️ ContractGuard Environment Variables
# Copy this file to `.env` and fill in your OpenRouter API Key
# ==========================================

# OpenRouter API Key for Layer 2 Auto-Labeling
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key-here

# Preferred OpenRouter Model (Default: google/gemini-flash-1.5 or openai/gpt-4o-mini)
OPENROUTER_MODEL=google/gemini-flash-1.5

# FastAPI Backend Settings
PORT=8000
ENVIRONMENT=development
